<div class="pokemon-card">
    <div class="pokemon-container">
        @if (pokemonData != null && pokemonData.sprites != null)
        {
            <img class="pokemon-sprite" src="@selectedPokemonVersion" />
        }

        <img class="pokeball-icon" src="images/Poké_Ball_icon.svg.png" />
    </div>

    <RadzenTextBox @bind-Value="@pokemonName"
                   Change="PkmnNameChanged"
                   Placeholder="Enter pokemon name">

    </RadzenTextBox>
    <RadzenDropDown @bind-Value="selectedPokemonVersion" Data="pokemonVersions" Placeholder="Select pokemon sprite">
        <Template>
            <div class="dropdown-item-container">
                <img src="@context" class="dropdown-pokemon-sprite" />
            </div>
        </Template>
    </RadzenDropDown>

    @if (evolutionVersions.Any())
    {
        <RadzenDropDown @bind-Value="selectedPokemonEvolution"
                        Data="evolutionVersions"
                        Change="EvolutionChange"
                        Placeholder="Select evolution version of the pokemon">
            <Template>
                <div class="dropdown-item-container">

                    <p>@context</p>
                </div>
            </Template>
        </RadzenDropDown>
    }

    <RadzenButton Style="border-radius:15px;" Click="Evolution">Evolution</RadzenButton>
</div>

@code {
    private Root? pokemonData { get; set; } = null;
    private string pokemonName { get; set; } = string.Empty;
    private string selectedPokemonVersion { get; set; } = string.Empty;
    private List<string> pokemonVersions { get; set; } = new List<string>();

    public string selectedPokemonEvolution { get; set; } = string.Empty;
    public List<string> evolutionVersions { get; set; } = new List<string>();

    protected override async Task OnInitializedAsync()
    {
        NotificationService.Notify(new NotificationMessage()
        {
            Duration = 10000,
            Severity = NotificationSeverity.Info,
            Detail = "Some pokemon selection are not supported. Meowstic f.e. is not available to select because it is not listed as a normal pokemon. Instead, its a species name."
        });
        await base.OnInitializedAsync();
    }

    private async Task PkmnNameChanged(string? obj)
    {
        try
        {
            pokemonData = await pokeApiExecuter.GetPokemonByName(obj.ToLower());

            if (pokemonData != null && pokemonData.sprites?.versions != null)
            {
                pokemonVersions.Clear();
                selectedPokemonVersion = string.Empty;



                var showdown = pokemonData.sprites.other?.showdown;

                if (showdown != null)
                {
                    var frontSprites = showdown.GetType()
                        .GetProperties()
                        .Where(x => x.Name.StartsWith("front", StringComparison.InvariantCultureIgnoreCase))
                        .Select(x => x.GetValue(showdown) as string)
                        .Where(url => !string.IsNullOrEmpty(url));

                    pokemonVersions.AddRange(frontSprites);
                }
                AddingPngAndGifPicturesFromPokemon();
                if (pokemonVersions.Any())
                {
                    selectedPokemonVersion = pokemonVersions.First();
                }
            }
        }
        catch (Exception e)
        {
            NotificationService.Notify(new NotificationMessage()
            {
                Severity = NotificationSeverity.Error,
                Detail = "Your pokemon was not found.",
                Duration = 4000
            });
        }
    }

    private void AddingPngAndGifPicturesFromPokemon()
    {
        foreach (var (generationName, kvpGameWithSprite) in pokemonData.sprites.versions)
        {
            foreach (var (version, gamespriteObject) in kvpGameWithSprite)
            {
                if (!string.IsNullOrEmpty(gamespriteObject.front_default))
                {
                    pokemonVersions.Add(gamespriteObject.front_default);
                }
            }
        }
    }

    private async Task Evolution()
    {
        try
        {
            var speciesName = pokemonData?.species?.name ?? pokemonName.ToLower().Trim();
            var speciesResponse = await pokeApiExecuter.GetPokemonBySpeciesName(speciesName);

            if (speciesResponse?.evolution_chain == null)
                throw new Exception("No evolution chain for this species found");


            string cleanUrl = speciesResponse.evolution_chain.url.TrimEnd('/');
            string id = cleanUrl.Substring(cleanUrl.LastIndexOf('/') + 1);
            var evolutionChainReponse = await pokeApiExecuter.GetEvolutionChain(id);


            var newPokemonName = GetNextEvolutionName(evolutionChainReponse.chain, speciesName);

            if (evolutionVersions.Any())
            {
                return;
            }

            if (string.IsNullOrEmpty(newPokemonName) || newPokemonName.Equals(speciesName, StringComparison.CurrentCultureIgnoreCase))
            {
                throw new Exception("End of evolution chain");
            }

            pokemonName = newPokemonName;
            await PkmnNameChanged(newPokemonName);
        }
        catch (Exception e)
        {
            NotificationService.Notify(new NotificationMessage()
            {
                Severity = NotificationSeverity.Error,
                Detail = "Your pokemon has no evolution stages anymore",
                Duration = 4000,
            });
        }
    }

    private string GetNextEvolutionName(ChainLink rootChain, string currentPokemonName)
    {
        try
        {

            string nextEvolution = RecursionMethod(rootChain, currentPokemonName);


            if (string.IsNullOrEmpty(nextEvolution))
            {
                throw new Exception("Keine Entwicklung gefunden");
            }

            return nextEvolution;
        }
        catch (Exception ex)
        {
            NotificationService.Notify(new NotificationMessage()
            {
                Severity = NotificationSeverity.Error,
                Detail = "This pokemon has no evolution stages",
                Duration = 4000
            });
        }

        return null;
    }

    private async Task EvolutionChange(object obj)
    {
        evolutionVersions.Clear();
        await PkmnNameChanged(obj as string);

    }

    private string RecursionMethod(ChainLink node, string currentPokeName)
    {

        if (node.species.name.Equals(currentPokeName, StringComparison.InvariantCultureIgnoreCase))
        {
            if (!node.evolves_to.Any())
            {
                return string.Empty;
            }

            if (node.evolves_to.Count == 1)
            {
                return node.evolves_to[0].species.name;
            }

            if (node.evolves_to.Count > 1)
            {
                evolutionVersions.Clear();
                foreach (var evolution in node.evolves_to)
                {
                    evolutionVersions.Add(evolution.species.name);
                }

                return currentPokeName;
            }
        }

        foreach (var childNode in node.evolves_to)
        {

            string result = RecursionMethod(childNode, currentPokeName);


            if (!string.IsNullOrEmpty(result))
            {
                return result;
            }
        }

        return string.Empty;

    }


}
